# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/khanatural"
# Canonical site origin (no trailing slash) — used for metadata, sitemap, JSON-LD
SITE_URL="https://khanatural.com"
# Secret for signing admin session tokens (generate: openssl rand -hex 32)
AUTH_SECRET=""
# Initial admin credentials created by `npm run db:seed`.
# The seed only CREATES the account; to change a password use `npm run admin:password`.
ADMIN_EMAIL="sales@khanatural.com"
ADMIN_PASSWORD=""

# --- Yoco payments ---------------------------------------------------------
# Secret key from the Yoco dashboard (Sell Online → Integrations → API keys).
# Test keys start sk_test_, live keys sk_live_. Server-side only — never expose.
# Leaving this unset does not break checkout: orders are still saved, the
# customer just gets the manual-payment confirmation instead of a card page.
YOCO_SECRET_KEY=""
# Returned once when you register the webhook endpoint, and starts with whsec_:
#   curl -X POST https://payments.yoco.com/api/webhooks \
#        -H "Authorization: Bearer $YOCO_SECRET_KEY" \
#        -H "Content-Type: application/json" \
#        -d '{"name":"khanatural","url":"https://YOUR-DOMAIN/api/webhooks/yoco/"}'
# Without it the webhook rejects everything and no order is ever marked paid.
YOCO_WEBHOOK_SECRET=""
