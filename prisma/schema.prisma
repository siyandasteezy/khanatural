generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Catalogue ----------

model Product {
  id                String         @id @default(cuid())
  wpId              Int?           @unique // original WordPress post ID, kept for migration traceability
  name              String
  slug              String         @unique
  sku               String?
  shortDescription  String         @default("") // sanitised HTML from WooCommerce
  description       String         @default("") // sanitised HTML from WooCommerce
  priceCents        Int
  regularPriceCents Int
  salePriceCents    Int?
  onSale            Boolean        @default(false)
  currency          String         @default("ZAR")
  inStock           Boolean        @default(true)
  isPublished       Boolean        @default(true)
  averageRating     Float          @default(0)
  reviewCount       Int            @default(0)
  weight            String?
  seoTitle          String?
  seoDescription    String?
  images            ProductImage[]
  categories        Category[]
  tags              Tag[]
  orderItems        OrderItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([isPublished, inStock])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Category {
  id             String    @id @default(cuid())
  wpId           Int?      @unique
  name           String
  slug           String    @unique
  description    String    @default("")
  sortOrder      Int       @default(0)
  seoTitle       String?
  seoDescription String?
  products       Product[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int         @unique @default(autoincrement())
  status        OrderStatus @default(PENDING)
  customerName  String
  customerEmail String
  customerPhone String      @default("")
  addressLine1  String
  addressLine2  String      @default("")
  city          String
  province      String
  postalCode    String
  country       String      @default("South Africa")
  notes         String      @default("")
  subtotalCents Int
  shippingCents Int
  totalCents    Int
  currency      String      @default("ZAR")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      String?
  name           String // snapshot at time of order
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
}

// ---------- Magazine / content ----------

enum ArticleKind {
  EMAG_ISSUE
  NEWS
  ARTICLE
}

model Article {
  id             String      @id @default(cuid())
  kind           ArticleKind @default(ARTICLE)
  title          String
  slug           String      @unique
  excerpt        String      @default("")
  content        String      @default("") // HTML
  coverImage     String?
  downloadUrl    String? // e-Mag PDF download
  isPublished    Boolean     @default(true)
  publishedAt    DateTime    @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([kind, isPublished, publishedAt])
}

// Structured content blocks migrated from WordPress/Elementor pages,
// editable through the admin CMS.
model Page {
  id             String  @id @default(cuid())
  slug           String  @unique // "" = homepage
  title          String
  metaTitle      String?
  metaDescription String?
  blocks         Json    @default("[]") // ordered [{type, text|src, alt}]
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id        String @id @default(cuid())
  author    String
  location  String @default("")
  quote     String
  imageUrl  String?
  sortOrder Int    @default(0)
  isPublished Boolean @default(true)
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  alt       String   @default("")
  folder    String   @default("uploads")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------- Admin ----------

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}
